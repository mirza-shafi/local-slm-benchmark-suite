# Environment variables for backend configuration

# Logging
LOG_LEVEL=INFO

# Model paths (auto-detected to ~/.cache/slm-benchmark/models)
# MODEL_CACHE_DIR=/custom/path

# Inference settings
DEFAULT_MAX_TOKENS=256
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.95
INFERENCE_TIMEOUT=300

# API
API_PORT=8000
API_HOST=0.0.0.0

# Development
DEBUG=false
